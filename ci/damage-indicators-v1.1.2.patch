@@ -0,0 +1,115 @@
+package com.astryxion.damageindicators;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.Holder;
+import net.minecraft.network.protocol.game.ClientboundRemoveMobEffectPacket;
+import net.minecraft.network.protocol.game.ClientboundUpdateMobEffectPacket;
+import net.minecraft.world.effect.MobEffect;
+import net.minecraft.world.effect.MobEffectInstance;
+import net.minecraft.world.entity.LivingEntity;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Client-side fallback cache for mob-effect packets.
+ *
+ * Vanilla normally copies these packets into LivingEntity#getActiveEffects(), but some
+ * mod combinations can leave that collection empty or replace it between packet handling
+ * and HUD rendering. Keeping the packet data independently makes the HUD reliable without
+ * requiring the mod on the server.
+ */
+public final class ClientEffectTracker {
+    private static final Map<Integer, Map<Holder<MobEffect>, TrackedEffect>> EFFECTS = new ConcurrentHashMap<>();
+
+    private ClientEffectTracker() {
+    }
+
+    public static void onEffectUpdate(ClientboundUpdateMobEffectPacket packet) {
+        long gameTime = currentGameTime();
+        TrackedEffect tracked = new TrackedEffect(
+                packet.getEffect(),
+                packet.getEffectDurationTicks(),
+                packet.getEffectAmplifier(),
+                packet.isEffectAmbient(),
+                packet.isEffectVisible(),
+                packet.effectShowsIcon(),
+                gameTime
+        );
+        EFFECTS.computeIfAbsent(packet.getEntityId(), ignored -> new ConcurrentHashMap<>())
+                .put(packet.getEffect(), tracked);
+    }
+
+    public static void onEffectRemove(ClientboundRemoveMobEffectPacket packet) {
+        Map<Holder<MobEffect>, TrackedEffect> entityEffects = EFFECTS.get(packet.entityId());
+        if (entityEffects == null) {
+            return;
+        }
+        entityEffects.remove(packet.effect());
+        if (entityEffects.isEmpty()) {
+            EFFECTS.remove(packet.entityId());
+        }
+    }
+
+    public static List<MobEffectInstance> getEffects(LivingEntity entity) {
+        // Prefer the live vanilla collection whenever it is populated, then merge packet-cached
+        // effects that may have been lost by another client mod or a timing race.
+        Map<Holder<MobEffect>, MobEffectInstance> merged = new LinkedHashMap<>();
+        for (MobEffectInstance effect : entity.getActiveEffects()) {
+            if (effect.getDuration() != 0) {
+                merged.put(effect.getEffect(), effect);
+            }
+        }
+
+        Map<Holder<MobEffect>, TrackedEffect> cached = EFFECTS.get(entity.getId());
+        if (cached != null) {
+            long gameTime = currentGameTime();
+            cached.entrySet().removeIf(entry -> entry.getValue().remainingDuration(gameTime) == 0);
+            for (TrackedEffect tracked : cached.values()) {
+                int remaining = tracked.remainingDuration(gameTime);
+                if (remaining != 0) {
+                    merged.putIfAbsent(tracked.effect(), tracked.toInstance(remaining));
+                }
+            }
+            if (cached.isEmpty()) {
+                EFFECTS.remove(entity.getId());
+            }
+        }
+
+        return new ArrayList<>(merged.values());
+    }
+
+    public static void clear() {
+        EFFECTS.clear();
+    }
+
+    private static long currentGameTime() {
+        Minecraft minecraft = Minecraft.getInstance();
+        return minecraft.level != null ? minecraft.level.getGameTime() : 0L;
+    }
+
+    private record TrackedEffect(
+            Holder<MobEffect> effect,
+            int duration,
+            int amplifier,
+            boolean ambient,
+            boolean visible,
+            boolean showIcon,
+            long receivedAtGameTime
+    ) {
+        int remainingDuration(long gameTime) {
+            if (duration < 0) {
+                return duration; // Infinite duration.
+            }
+            long elapsed = Math.max(0L, gameTime - receivedAtGameTime);
+            return (int) Math.max(0L, (long) duration - elapsed);
+        }
+
+        MobEffectInstance toInstance(int remainingDuration) {
+            return new MobEffectInstance(effect, remainingDuration, amplifier, ambient, visible, showIcon);
+        }
+    }
+}
