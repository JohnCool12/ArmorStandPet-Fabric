+package com.b1n_ry.yigd.mixin;
+
+import net.minecraft.resources.ResourceKey;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.gen.Accessor;
+
+/**
+ * Accesses the key of RegistryLoadTask.PendingRegistration without exposing the
+ * protected nested vanilla type in YiGD's source signature.
+ */
+@Mixin(targets = "net.minecraft.resources.RegistryLoadTask$PendingRegistration")
+public interface RegistryPendingRegistrationAccessor {
+    @Accessor("key")
+    ResourceKey<?> yigd$getKey();
+}
