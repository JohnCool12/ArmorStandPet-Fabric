+package limitless.enchantments;
+
+import java.util.ArrayList;
+
+import net.minecraft.core.Holder;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.enchantment.Enchantment;
+import net.minecraft.world.item.enchantment.EnchantmentHelper;
+
+/**
+ * Keeps naturally generated enchantment levels vanilla while leaving the
+ * mod's intentionally limitless progression paths (anvils, trades, commands,
+ * existing stacks, etc.) unchanged.
+ */
+public final class VanillaEnchantmentLevels {
+    private static final ThreadLocal<Integer> VANILLA_GENERATION_DEPTH = ThreadLocal.withInitial(() -> 0);
+
+    private VanillaEnchantmentLevels() {
+    }
+
+    public static void beginVanillaGeneration() {
+        VANILLA_GENERATION_DEPTH.set(VANILLA_GENERATION_DEPTH.get() + 1);
+    }
+
+    public static void endVanillaGeneration() {
+        int depth = VANILLA_GENERATION_DEPTH.get() - 1;
+        if (depth <= 0) {
+            VANILLA_GENERATION_DEPTH.remove();
+        } else {
+            VANILLA_GENERATION_DEPTH.set(depth);
+        }
+    }
+
+    public static boolean shouldUseVanillaMaxLevel() {
+        return VANILLA_GENERATION_DEPTH.get() > 0;
+    }
+
+    /**
+     * Safety backstop for loot-table-filled containers. This clamps both
+     * normal item enchantments and stored enchanted-book enchantments because
+     * EnchantmentHelper.updateEnchantments chooses the correct component type.
+     */
+    public static void clampStackToVanillaMax(ItemStack stack) {
+        if (stack.isEmpty()) {
+            return;
+        }
+
+        EnchantmentHelper.updateEnchantments(stack, enchantments -> {
+            for (Holder<Enchantment> enchantment : new ArrayList<>(enchantments.getEnchantments())) {
+                int level = enchantments.getLevel(enchantment);
+                int vanillaMax = enchantment.value().definition().maxLevel();
+                if (level > vanillaMax) {
+                    enchantments.set(enchantment, vanillaMax);
+                }
+            }
+        });
+    }
+}
