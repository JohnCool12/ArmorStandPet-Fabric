 /** Uses the vanilla 26.1.2 armor-stand renderer for the custom pet entity. */
 public final class PetArmorStandRenderer extends ArmorStandRenderer
@@ -13,4 +16,23 @@
 	{
 		super(context);
 	}
+
+	@Override
+	public void extractRenderState(ArmorStand entity, ArmorStandRenderState state, float partialTick)
+	{
+		super.extractRenderState(entity, state, partialTick);
+
+		/*
+		 * Minecraft 26.1.x's ItemInHandLayer applies a generic baby held-item
+		 * offset whenever state.isBaby is true unless state.entityType is exactly
+		 * EntityType.ARMOR_STAND. PetArmorStandEntity inherits ArmorStand.isBaby(),
+		 * so a small pet is correctly marked as a baby but its custom entity type
+		 * accidentally triggers that non-armor-stand offset. Normalize only the
+		 * small pet's render-state type to the vanilla armor stand type so vanilla
+		 * hand-item placement is reproduced exactly without changing the real
+		 * registered entity type or any server/gameplay behavior.
+		 */
+		if (state.isSmall)
+			state.entityType = EntityType.ARMOR_STAND;
+	}
 }
