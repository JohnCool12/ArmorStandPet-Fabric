+    /** Shared ranged-projectile kill-credit bridge. */
+    public static void creditOwnerKill(Object petObject, Object targetObject)
+    {
+        if (!(petObject instanceof Pet pet) || !(targetObject instanceof Mob target)) return;
+        PetArmorStandEntity stand = pet.getStand();
+        if (stand == null || stand.isRemoved()) return;
+        ServerLevel level = stand.serverLevel();
+        ServerPlayer creditedOwner = level.getServer().getPlayerList().getPlayerByName(pet.getOwner());
+        if (creditedOwner != null) target.setLastHurtByPlayer(creditedOwner, 100);
+    }
