+    private static void drawPotionEffects(GuiGraphics guiGraphics, LivingEntity entity) {
+        List<MobEffectInstance> effects = new ArrayList<>();
+        for (MobEffectInstance effect : entity.getActiveEffects()) {
+            // INFINITE_DURATION is negative, so the old duration > 10 check silently removed it.
+            // The config promises target effects, so do not also require vanilla particle/icon flags.
+            if (effect.getDuration() != 0) {
+                effects.add(effect);
+            }
+        }
+        if (effects.isEmpty()) {
+            return;
+        }
+
+        Minecraft minecraft = Minecraft.getInstance();
+        MobEffectTextureManager effectTextures = minecraft.getMobEffectTextures();
+        Font font = minecraft.font;
+        PoseStack poseStack = guiGraphics.pose();
+        boolean hasOverflow = effects.size() > MAX_VISIBLE_EFFECTS;
+        int visibleCount = hasOverflow ? MAX_VISIBLE_EFFECTS - 1 : effects.size();
+
+        RenderSystem.enableBlend();
+        RenderSystem.defaultBlendFunc();
+        for (int i = 0; i < visibleCount; i++) {
+            MobEffectInstance effect = effects.get(i);
+            int cellX = EFFECT_ROW_X + i * EFFECT_CELL_SPACING;
+
+            guiGraphics.fill(cellX, EFFECT_ROW_Y, cellX + EFFECT_CELL_SIZE, EFFECT_ROW_Y + EFFECT_CELL_SIZE, 0xA0000000);
+            TextureAtlasSprite sprite = effectTextures.get(effect.getEffect());
+            guiGraphics.blit(cellX + 1, EFFECT_ROW_Y + 1, 0, EFFECT_ICON_SIZE, EFFECT_ICON_SIZE, sprite);
+
+            Component duration = MobEffectUtil.formatDuration(effect, 1.0F,
+                    minecraft.level != null ? minecraft.level.tickRateManager().tickrate() : 20.0F);
+            String durationText = duration.getString();
+            int textWidth = font.width(durationText);
+            float textScale = 0.5F;
+            poseStack.pushPose();
+            poseStack.translate(cellX + EFFECT_CELL_SIZE - textWidth * textScale - 1.0F,
+                    EFFECT_ROW_Y + EFFECT_CELL_SIZE - font.lineHeight * textScale, 1.0F);
+            poseStack.scale(textScale, textScale, 1.0F);
+            guiGraphics.drawString(font, durationText, 0, 0, 0xFFFFFF80, true);
+            poseStack.popPose();
+        }
+
+        if (hasOverflow) {
+            int overflowX = EFFECT_ROW_X + (MAX_VISIBLE_EFFECTS - 1) * EFFECT_CELL_SPACING;
+            guiGraphics.fill(overflowX, EFFECT_ROW_Y, overflowX + EFFECT_CELL_SIZE, EFFECT_ROW_Y + EFFECT_CELL_SIZE, 0xA0000000);
+            String overflow = "+" + (effects.size() - visibleCount);
+            int overflowTextX = overflowX + (EFFECT_CELL_SIZE - font.width(overflow)) / 2;
+            guiGraphics.drawString(font, overflow, overflowTextX, EFFECT_ROW_Y + 5, 0xFFFFFFFF, true);
+        }
+        guiGraphics.flush();
+    }
