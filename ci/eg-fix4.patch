+	/**
+	 * These material golems intentionally use the vanilla Iron Golem sound profile.
+	 * Because this entity extends {@link IronGolem}, delegating to super preserves
+	 * the exact vanilla hurt/death behavior while inherited step, attack, and
+	 * crack/damage sounds remain unchanged.
+	 */
+	private boolean usesIronGolemSounds() {
+		return getGolemId().map(id -> ExtraGolems.MODID.equals(id.getNamespace()) && switch (id.getPath()) {
+			case "netherite", "emerald", "gold", "lapis", "diamond", "obsidian", "crying_obsidian",
+					"coal", "quartz", "redstone" -> true;
+			default -> false;
+		}).orElse(false);
+	}
+
